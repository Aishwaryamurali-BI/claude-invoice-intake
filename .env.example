# Copy to .env and fill in. Never commit .env.

# --- Claude -------------------------------------------------------------------
# Live extraction needs one of: ANTHROPIC_API_KEY here, or `ant auth login` on the host
# plus EXTRACT_MODE=live. With neither, the server runs in labelled keyless REPLAY mode,
# which only knows the synthetic invoices in evals/cases/.
ANTHROPIC_API_KEY=
# EXTRACT_MODE=live

# --- MCP server auth ----------------------------------------------------------
# name=token pairs, comma-separated. Tokens must be 32+ characters.
# Generate one with: openssl rand -hex 32
# Read scope: extract_invoice, list_pending_approvals, payables_forecast
READ_TOKENS=n8n-reader=
# Read + approve scope: also approve_invoice, reject_invoice
APPROVER_TOKENS=n8n-approver=,aishu=
# Humans whose names may appear as `approver`. A person's own token can only approve as
# themselves; a service token (n8n-approver) may relay any name on this list.
APPROVERS=aishu

# --- n8n (docker compose) -------------------------------------------------------
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=America/Denver
N8N_WEBHOOK_URL=http://localhost:5678/
