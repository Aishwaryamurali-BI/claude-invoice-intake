    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// The HTTP call can succeed while the tool says no (e.g. invoice already decided, or the\n// approver isn't on the server's APPROVERS list). Fail loudly so the Error workflow alerts.\nconst r = $json;\nif (r.error) throw new Error('MCP error: ' + r.error.message);\nif (r.result?.isError) throw new Error('Decision not saved: ' + (r.result.content?.[0]?.text || 'unknown'));\nreturn { json: r.result.structuredContent };"
      },
      "name": "Confirm decision saved",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2600,
        0
      ],
      "id": "eecfcab4-3f4e-5606-8a78-e69ef6ff4eae"
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Config').item.json.review_channel }}"
        },
        "text": "={{ ':warning: *Invoice failed checks, not sent for approval*\\n' + $json.vendor + ' ' + $json.invoice_number + ', ' + $json.currency + ' ' + $json.total + '\\n' + $json.failed_checks.join('\\n') + '\\n\\nIt is staged as pending. To approve anyway, an approver uses approve_invoice with an override_reason (e.g. from Claude). Record: ' + $json.id }}",
        "otherOptions": {}
